{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "VS Code Extension: watch",
            "type": "npm",
            "script": "watch",
            "path": "src/vscode",
            "isBackground": true,
            "problemMatcher": "$tsc-watch",
            "presentation": {
                "reveal": "never"
            },
            "group": {
                "kind": "build"
            }
        },
        {
            "label": "VS Code Extension: compile",
            "type": "npm",
            "script": "compile",
            "path": "src/vscode",
            "problemMatcher": "$tsc"
        }
    ]
}