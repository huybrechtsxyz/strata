{
    "[json]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.detectIndentation": false
    },
    "[yaml]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.detectIndentation": false,
        "editor.defaultFormatter": "redhat.vscode-yaml",
        "editor.formatOnSave": true
    },
    "[markdown]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.detectIndentation": false,
        "editor.defaultFormatter": "yzhang.markdown-all-in-one",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.markdownlint": "explicit"
        }
    },
    "[shellscript]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.detectIndentation": false
    },
    "[powershell]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "editor.detectIndentation": false
    },
    "[python]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "editor.detectIndentation": false,
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
        }
    },
    "editor.formatOnSave": true,
    "files.eol": "\n",
    "files.associations": {
        ".github/workflows/*.yml": "github-actions-workflow",
        ".github/workflows/*.yaml": "github-actions-workflow",
        ".github/actions/**/action.yml": "github-actions-workflow",
        ".github/actions/**/action.yaml": "github-actions-workflow"
    },
    "files.exclude": {
        "**/.git": true,
        ".ruff_cache": true,
        ".mypy_cache": true,
        ".import_linter_cache": true,
        ".nox": true,
        ".pytest_cache": true,
        ".coverage": true
    },
    "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
    "python-envs.pythonProjects": [
        {
            "path": ".",
            "envManager": "ms-python.python:uv",
            "packageManager": "ms-python.python:uv"
        }
    ],
    "python.testing.cwd": "${workspaceFolder}",
    "python.testing.pytestArgs": [
        "tests"
    ],
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,
    // The mypy extension invokes mypy with explicit file paths, which makes
    // `exclude = "^tests/"` in pyproject.toml ineffective for editor diagnostics.
    // ignorePatterns is the extension-level equivalent.
    "mypy-type-checker.ignorePatterns": [
        "tests/**"
    ]
}