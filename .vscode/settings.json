{
    "python.testing.pytestArgs": [
        "tests"
    ],
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,
    // The mypy extension invokes mypy with explicit file paths, which makes
    // `exclude = "^tests/"` in pyproject.toml ineffective for editor diagnostics.
    // ignorePatterns is the extension-level equivalent.
    "mypy-type-checker.ignorePatterns": [
        "tests/**"
    ]
}