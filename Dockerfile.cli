# syntax=docker/dockerfile:1

# ============================================================
# Stage 1 – builder: install dependencies with uv
# ============================================================
FROM python:3.13-slim AS builder

# Install uv, pinned: `latest` would make the build depend on the day it ran (docs/design/cli-image.md)
COPY --from=ghcr.io/astral-sh/uv:0.9.22 /uv /usr/local/bin/uv

WORKDIR /app

# Copy manifest, lockfile and version first for layer caching
COPY pyproject.toml uv.lock VERSION.txt ./
COPY src/ src/

# Install production dependencies only into an in-project .venv, at the versions in uv.lock (what CI tested).
# --locked fails the build when the lockfile no longer matches pyproject.toml, instead of resolving afresh.
RUN uv sync --locked --no-dev --no-editable

# ============================================================
# Stage 2 – runtime: lean image with only the installed venv
# ============================================================
FROM python:3.13-slim

ARG VERSION=dev

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH" \
    APP_VERSION=${VERSION}

LABEL org.opencontainers.image.title="strata" \
      org.opencontainers.image.description="Strata CLI — infrastructure workspace management" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later" \
      org.opencontainers.image.source="https://github.com/huybrechtsxyz/strata"

WORKDIR /app

# Copy the pre-built virtual environment from the builder stage
COPY --from=builder /app/.venv /app/.venv

# git: strata itself calls it (fetching remotes at build, the commit SHA in the audit record and the image gate,
# audit push to a git sink, the GitOps integration). openssh-client: `auth.method: ssh_key` runs git over ssh.
# Provisioner tools (terraform, helm, docker) stay out: a pipeline brings the versions it pins (docs/design/cli-image.md).
# safe.directory: a checkout mounted with `docker run -v` belongs to another user, and git refuses it as "dubious
# ownership"; `git rev-parse HEAD` would then fail and the audit record would silently lose its commit SHA.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git openssh-client \
    && rm -rf /var/lib/apt/lists/* \
    && git config --system --add safe.directory '*'

# Run as non-root, with a home directory: git, ssh and any tool a pipeline adds on top (Helm's cache,
# ~/.kube/config) write under $HOME.
RUN useradd --create-home --shell /bin/bash appuser
USER appuser
ENV HOME=/home/appuser

# The CLI is invoked as: docker run <image> <command> [options]
# e.g.: docker run strata validate my-config.yaml
ENTRYPOINT ["strata"]
CMD ["--help"]
