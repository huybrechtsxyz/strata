# syntax=docker/dockerfile:1

# strata's container image, in two variants (docs/design/cli-image.md):
#   --target slim : strata and the tools strata itself calls (git, ssh). Published as `strata:<v>`, `<v>-slim`, `latest`.
#   --target full : slim plus the tools a pipeline runs strata with: OpenTofu, Helm 4, the Docker CLI with Compose,
#                   Trivy and Checkov. Published as `strata:<v>-full`. No Terraform: its BSL licence is not settled for
#                   a public image; OpenTofu (MPL 2.0) runs the same root modules (`tool: opentofu`, ADR-0060).
# Without --target the build gives slim (the last stage).

# ------------------------------------------------------------------------------------------------------------------
# Pinned inputs. A `FROM` line is kept current by Dependabot (docker); the ARGs below are bumped by hand.
# ------------------------------------------------------------------------------------------------------------------
# uv, pinned: `latest` would make the build depend on the day it ran. A stage of its own so Dependabot, which
# updates `FROM` lines only, keeps the pin current.
FROM ghcr.io/astral-sh/uv:0.9.22 AS uv
# The Docker CLI and its Compose plugin (static binaries, copied into the full image).
FROM docker:28.3.2-cli AS docker-cli
# Trivy, an exact version: a poisoned v0.69.4 was published through several channels in March 2026.
FROM aquasec/trivy:0.76.2 AS trivy
# OpenTofu: its minimal image exists to copy the `tofu` binary from.
FROM ghcr.io/opentofu/opentofu:1.13.9-minimal AS tofu

# ==================================================================================================================
# builder: strata and its production dependencies, at the versions in uv.lock (what CI tested)
# ==================================================================================================================
FROM python:3.13-slim AS builder

COPY --from=uv /uv /usr/local/bin/uv

WORKDIR /app

# Copy manifest, lockfile and version first for layer caching
COPY pyproject.toml uv.lock VERSION.txt ./
COPY src/ src/

# --locked fails the build when the lockfile no longer matches pyproject.toml, instead of resolving afresh.
RUN uv sync --locked --no-dev --no-editable

# ==================================================================================================================
# checkov-builder: Checkov in a venv of its own, so its dependencies never meet strata's
# ==================================================================================================================
FROM python:3.13-slim AS checkov-builder

COPY --from=uv /uv /usr/local/bin/uv
# The version lives in a requirements file so Dependabot (pip, /docker/checkov) keeps it current.
COPY docker/checkov/requirements.txt /tmp/checkov-requirements.txt
RUN uv venv /opt/checkov \
    && uv pip install --python /opt/checkov/bin/python --no-cache -r /tmp/checkov-requirements.txt

# ==================================================================================================================
# slim: strata and the tools strata itself calls
# ==================================================================================================================
FROM python:3.13-slim AS slim

ARG VERSION=dev

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH" \
    APP_VERSION=${VERSION}

LABEL org.opencontainers.image.title="strata" \
      org.opencontainers.image.description="Strata CLI — infrastructure workspace management" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later" \
      org.opencontainers.image.source="https://github.com/huybrechtsxyz/strata"

WORKDIR /app

# Copy the pre-built virtual environment from the builder stage
COPY --from=builder /app/.venv /app/.venv

# git: strata itself calls it (fetching remotes at build, the commit SHA in the audit record and the image gate,
# audit push to a git sink, the GitOps integration). openssh-client: `auth.method: ssh_key` runs git over ssh.
# Provisioner tools stay out of slim: the full image has them, or a pipeline brings the versions it pins.
# safe.directory: a checkout mounted with `docker run -v` belongs to another user, and git refuses it as "dubious
# ownership"; `git rev-parse HEAD` would then fail and the audit record would silently lose its commit SHA.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git openssh-client \
    && rm -rf /var/lib/apt/lists/* \
    && git config --system --add safe.directory '*'

# Run as non-root, with a home directory: git, ssh and the tools in full (Helm's cache, ~/.kube/config, Trivy's
# database) write under $HOME.
RUN useradd --create-home --shell /bin/bash appuser
USER appuser
ENV HOME=/home/appuser

# The CLI is invoked as: docker run <image> <command> [options]
# e.g.: docker run strata validate my-config.yaml
ENTRYPOINT ["strata"]
CMD ["--help"]

# ==================================================================================================================
# full: slim plus OpenTofu, Helm 4, the Docker CLI with Compose, Trivy and Checkov
# ==================================================================================================================
FROM slim AS full

# Helm has no official image, so it comes from its release archive, checked against the published checksum.
ARG HELM_VERSION=4.3.1
ARG TARGETARCH=amd64

LABEL org.opencontainers.image.description="Strata CLI with OpenTofu, Helm, Docker Compose, Trivy and Checkov"

USER root

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && cd /tmp \
    && archive="helm-v${HELM_VERSION}-linux-${TARGETARCH}.tar.gz" \
    && curl -fsSLO "https://get.helm.sh/${archive}" \
    && curl -fsSLO "https://get.helm.sh/${archive}.sha256sum" \
    && sha256sum -c "${archive}.sha256sum" \
    && tar -xzf "${archive}" -C /usr/local/bin --strip-components=1 "linux-${TARGETARCH}/helm" \
    && rm -f "${archive}" "${archive}.sha256sum" \
    && apt-get purge -y curl \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose
COPY --from=trivy /usr/local/bin/trivy /usr/local/bin/trivy
COPY --from=tofu /usr/local/bin/tofu /usr/local/bin/tofu
COPY --from=checkov-builder /opt/checkov /opt/checkov
RUN ln -s /opt/checkov/bin/checkov /usr/local/bin/checkov

USER appuser

# ==================================================================================================================
# The default without --target: slim
# ==================================================================================================================
FROM slim
