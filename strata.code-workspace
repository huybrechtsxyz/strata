{
  "folders": [
    {
      "path": ".",
      "name": "Strata"
    }
  ],
  "settings": {
    "cSpell.words": [
      "Huybrechts",
      "pycache",
      "PYTHONPATH",
      "venv"
    ],
    "files.exclude": {
      ".vs/**": true,
      "**/.git": true,
      "**/.svn": true,
      "**/.hg": true,
      "**/CVS": true,
      "**/.DS_Store": true,
      "**/bin": true,
      "**/obj": true,
      "**/node_modules": true,
      "**/*.egg-info": true,
      ".pytest_cache": true,
      "**/__pycache__": true,
      "/__pycache__": true,
      "**/*.pyc": true
    },
    "vsicons.associations.files": [],
    "vsicons.associations.folders": [
      {
        "icon": "azurepipelines",
        "extensions": [
          "deploy"
        ],
        "format": "svg",
        "light": true
      },
      {
        "icon": "controller",
        "extensions": [
          "terraform"
        ],
        "format": "svg",
        "light": true
      },
      {
        "icon": "paket",
        "extensions": [
          "workspaces"
        ],
        "format": "svg",
        "light": true
      }
    ],
    "files.associations": {
      "**/.github/workflows/*.yaml": "github-actions-workflow",
      "**/.github/actions/**/action.yaml": "github-actions-workflow",
      "**/.terraformignore": "terraform"
    },
    "[yaml]": {
      "editor.insertSpaces": true,
      "editor.tabSize": 2,
      "editor.detectIndentation": false,
      "editor.defaultFormatter": "redhat.vscode-yaml",
      "editor.formatOnSave": true
    },
    "yaml.schemas": {
      "${workspaceFolder}/.strata/schemas/strata.json": [
        "**/config/*.yaml",
        "**/deploy/*.yaml",
        "**/envs/*.yaml",
        "**/environments/*.yaml",
        "**/modules/*.yaml",
        "**/namespaces/*.yaml",
        "**/providers/*.yaml",
        "**/resources/*.yaml",
        "**/firewalls/*.yaml",
        "**/networks/*.yaml",
        "**/dns/*.yaml",
        "**/tenants/*.yaml",
        "**/stack/*.yaml"
      ]
    },
    "powershell.pester.codeLens": false
  }
}