{
  "name": "xyz-strata",
  "displayName": "Strata",
  "description": "Validate strata solutions on every save, explore how their documents reference each other, and get schema autocomplete for every document kind.",
  "version": "2.0.0",
  "publisher": "huybrechts-xyz",
  "license": "AGPL-3.0-or-later",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#14202E",
    "theme": "dark"
  },
  "homepage": "https://github.com/huybrechtsxyz/strata#readme",
  "bugs": {
    "url": "https://github.com/huybrechtsxyz/strata/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/huybrechtsxyz/strata.git",
    "directory": "src/vscode"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "strata",
    "terraform",
    "helm",
    "docker-compose",
    "infrastructure-as-code",
    "iac",
    "yaml",
    "devops"
  ],
  "activationEvents": [
    "workspaceContains:strata.yaml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "strata.validate",
        "title": "Strata: Validate Solution",
        "icon": "$(check)"
      },
      {
        "command": "strata.refreshGraph",
        "title": "Strata: Refresh Graph",
        "icon": "$(refresh)"
      },
      {
        "command": "strata.openGraphLocation",
        "title": "Strata: Open Reference Location"
      },
      {
        "command": "strata.updateSolution",
        "title": "Strata: Update Solution Files (schemas, scaffold)",
        "icon": "$(sync)"
      },
      {
        "command": "strata.selectDeployment",
        "title": "Strata: Select Deployment",
        "icon": "$(rocket)"
      },
      {
        "command": "strata.refreshIntegrations",
        "title": "Strata: Refresh Integrations",
        "icon": "$(refresh)"
      },
      {
        "command": "strata.checkIntegration",
        "title": "Check Connection",
        "icon": "$(plug)"
      },
      {
        "command": "strata.refreshPolicies",
        "title": "Strata: Refresh Policies",
        "icon": "$(refresh)"
      },
      {
        "command": "strata.checkPolicy",
        "title": "Strata: Check Policies",
        "icon": "$(play)"
      },
      {
        "command": "strata.showPolicyFindings",
        "title": "Show Findings",
        "icon": "$(list-unordered)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "strata.refreshGraph",
          "when": "view == strataGraph",
          "group": "navigation"
        },
        {
          "command": "strata.selectDeployment",
          "when": "view == strataIntegrations || view == strataPolicies",
          "group": "navigation@1"
        },
        {
          "command": "strata.refreshIntegrations",
          "when": "view == strataIntegrations",
          "group": "navigation@2"
        },
        {
          "command": "strata.checkPolicy",
          "when": "view == strataPolicies",
          "group": "navigation@2"
        },
        {
          "command": "strata.refreshPolicies",
          "when": "view == strataPolicies",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "strata.checkIntegration",
          "when": "view == strataIntegrations && viewItem == integration",
          "group": "inline"
        },
        {
          "command": "strata.checkPolicy",
          "when": "view == strataPolicies && viewItem =~ /;check/",
          "group": "inline@1"
        },
        {
          "command": "strata.showPolicyFindings",
          "when": "view == strataPolicies && viewItem =~ /;findings/",
          "group": "inline@2"
        }
      ],
      "commandPalette": [
        {
          "command": "strata.openGraphLocation",
          "when": "false"
        },
        {
          "command": "strata.checkIntegration",
          "when": "false"
        },
        {
          "command": "strata.showPolicyFindings",
          "when": "false"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "strata",
          "title": "Strata",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "strata": [
        {
          "id": "strataGraph",
          "name": "Graph"
        },
        {
          "id": "strataIntegrations",
          "name": "Integrations"
        },
        {
          "id": "strataPolicies",
          "name": "Policies"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "strata.gettingStarted",
        "title": "Get started with Strata",
        "description": "From an installed CLI to a validated solution, with autocomplete and an AI agent that knows strata.",
        "steps": [
          {
            "id": "strata.gettingStarted.cli",
            "title": "Install the strata CLI",
            "description": "Every check in this extension is the real `strata` CLI. Install it once, or let the extension find it in your project's `.venv`.\n[Configure the CLI path](command:workbench.action.openSettings?%5B%22strata.cliPath%22%5D)",
            "media": {
              "markdown": "resources/walkthrough/cli.md"
            }
          },
          {
            "id": "strata.gettingStarted.solution",
            "title": "Open a solution",
            "description": "Strata starts when the folder you open contains a `strata.yaml`. No solution yet? Create one with `strata sln init`.\n[Open Folder](command:workbench.action.files.openFolder)",
            "media": {
              "markdown": "resources/walkthrough/solution.md"
            }
          },
          {
            "id": "strata.gettingStarted.validate",
            "title": "Validate your solution",
            "description": "Check every document and every reference between them. From now on this happens each time you save.\n[Validate Solution](command:strata.validate)",
            "media": {
              "markdown": "resources/walkthrough/validate.md"
            }
          },
          {
            "id": "strata.gettingStarted.graph",
            "title": "Explore the reference graph",
            "description": "See which document points at which, and spot the references that don't resolve.\n[Open the Graph](command:strataGraph.focus)",
            "media": {
              "markdown": "resources/walkthrough/graph.md"
            },
            "completionEvents": [
              "onView:strataGraph"
            ]
          },
          {
            "id": "strata.gettingStarted.update",
            "title": "Turn on autocomplete and agent skills",
            "description": "Export a JSON Schema for every document kind, and give Claude and GitHub Copilot a strata skill.\n[Update Solution Files](command:strata.updateSolution)",
            "media": {
              "markdown": "resources/walkthrough/update.md"
            }
          }
        ]
      }
    ],
    "viewsWelcome": [
      {
        "view": "strataGraph",
        "contents": "No reference graph loaded yet.\n[Refresh Graph](command:strata.refreshGraph)\n\nRequires the `strata` CLI and a solution (`strata.yaml`) in this workspace."
      }
    ],
    "configuration": {
      "title": "Strata",
      "properties": {
        "strata.cliPath": {
          "type": "string",
          "default": "strata",
          "description": "Path to the strata CLI. Leave as 'strata' to auto-detect a workspace .venv/venv before falling back to PATH, or set an explicit override such as 'uv run strata'."
        },
        "strata.validateOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Re-validate the whole solution when a YAML file is saved."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.4.0",
    "typescript": "^5.4.0"
  }
}