# Strata — .strata/ gitignore
#
# Commit:   logging.yaml, collectors.yaml, sbom-ignore.yaml, lockfile_parsers/
# Ignore:   runtime-written state files, personal CLI prefs, build output, temp files

# Runtime-written state — never commit
cli.yaml
solution.json
audit.log
console-history
workitems/

# Build output — generated artifacts, never committed
build/

# Derived caches (model, cost, ai) — rebuildable from committed YAML, never commit
cache/

# Log output
logs/
*.log
*.json.log

# Local-only config overrides (never commit secrets or machine-specific paths)
local.*.yaml
*.local.yaml
.env
.env.*

# Python cache
__pycache__/
*.pyc
