apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: {{ integration.resource_name | default(name) }}
  namespace: {{ integration.flux_namespace | default('flux-system') }}
  labels:
    app.kubernetes.io/managed-by: strata
    strata/revision: "{{ revision | default('unknown') }}"
    {%- for k, v in labels.items() %}
    {{ k }}: "{{ v }}"
    {%- endfor %}
spec:
  interval: {{ integration.interval | default('5m0s') }}
  timeout: {{ integration.timeout | default('3m0s') }}
  prune: {{ integration.prune | default(true) | lower }}
  path: {{ integration.path | default('./kustomize') }}
  sourceRef:
    kind: GitRepository
    name: {{ integration.source_ref | default(name) }}
    namespace: {{ integration.flux_namespace | default('flux-system') }}
  targetNamespace: {{ integration.destination_namespace | default(layers.environment | default('default')) }}
  postBuild:
    substitute:
      REVISION: "{{ revision | default('') }}"
      {%- for k, v in resolved_variables.items() %}
      {{ k }}: "{{ v }}"
      {%- endfor %}
