# EditorConfig - https://editorconfig.org
# Generated by strata sln init. Safe to edit.
root = true

# Defaults
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Platform YAML files
[*.{yaml,yml}]
indent_style = space
indent_size = 2
max_line_length = 120

# JSON (schemas, solution registry)
[*.json]
indent_style = space
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# Shell scripts
[*.sh]
indent_style = space
indent_size = 2

# PowerShell
[*.ps1]
indent_style = space
indent_size = 4

# Terraform (if used alongside strata)
[*.tf]
indent_style = space
indent_size = 2
